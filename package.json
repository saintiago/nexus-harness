{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && chmod +x dist/src/application/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --cache-location .turbo/eslint/.eslintcache --cache-strategy content",
    "lint:fix": "eslint . --fix",
    "smoke:help": "npm run build && node dist/src/application/cli.js --help",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise .",
    "test": "vitest run --project component && vitest run --project integration && vitest run --project system",
    "test:watch": "vitest",
    "validate": "turbo run format:check lint typecheck boundaries test"
  },
  "bin": {
    "nexus": "dist/src/application/cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1138.0",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0",
    "xstate": "^5.33.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "2.11.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
