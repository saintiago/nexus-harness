{
  "name": "nexus-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first development harness: one CLI invocation runs a task through the workspace, check, and bounded repair loop.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "probe": "node -e \"console.log('probe ok')\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:policy": "vitest run --project policy",
    "test:boundary": "vitest run --project boundary",
    "test:four-workers": "vitest run --config vitest.four-workers.config.ts",
    "test:watch": "vitest",
    "test:live": "npm run build && tsx tests/live/codex-live-check.ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "string-width": "^8.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "2.11.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
