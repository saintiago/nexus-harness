{
  "name": "nexus-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first development harness: one CLI invocation runs a task through the workspace, check, and bounded repair loop.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --cache --cache-location .turbo/eslint/.eslintcache --cache-strategy content",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/turbo.mjs run format:check lint typecheck build test",
    "validate:fresh": "npm run cache:clear && npm run validate",
    "cache:clear": "node scripts/cache-clear.mjs"
  },
  "dependencies": {
    "string-width": "^8.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "2.11.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "xstate": "^5.33.2"
  }
}
