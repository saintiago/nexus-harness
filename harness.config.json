{
  "workDir": "./.harness",
  "maxRepairs": 2,
  "taskTimeoutMinutes": 60,
  "commandTimeoutMinutes": 10,
  "setup": [["npm", "ci"]],
  "checks": [
    ["npm", "run", "typecheck"],
    ["npm", "test"]
  ],
  "agent": {
    "runtime": "codex",
    "command": [
      "C:/Users/User/.codex/packages/standalone/current/bin/codex.exe",
      "--profile",
      "deepseek",
      "--model",
      "deepseek-flash"
    ]
  }
}
